# Copy to .env.local and fill in. Never commit .env.local.

# Owner (only this email can log in)
OWNER_EMAIL=

# SMTP (personal email; for Gmail use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# GitHub: GITHUB_TOKEN powers the dashboard repo import (needs access to private repos: classic `repo` scope, or a fine-grained token with Metadata: read on all repositories). Server-only, never NEXT_PUBLIC_.
GITHUB_USERNAME=
GITHUB_TOKEN=

# Neon (pulled by `neon deploy` / `neon checkout`; pooled URL for the app, unpooled for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 32+ chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Phase 4
GEMINI_API_KEY=
