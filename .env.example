# Copy to .env.local and fill in. Never commit .env.local.

# Owner (only this email can log in)
OWNER_EMAIL=

# SMTP (personal email; for Gmail use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# GitHub (optional, raises API rate limit; server-only, no NEXT_PUBLIC_)
GITHUB_USERNAME=
GITHUB_TOKEN=

# Phase 2+
DATABASE_URL=
SESSION_SECRET=
GEMINI_API_KEY=
