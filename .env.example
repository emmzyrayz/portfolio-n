# Copy to .env.local and fill in. Never commit .env.local.

# Owner (only this email can log in)
OWNER_EMAIL=

# SMTP (personal email; for Gmail use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# GitHub (optional, raises API rate limit; server-only, no NEXT_PUBLIC_)
GITHUB_USERNAME=
GITHUB_TOKEN=

# Neon (pulled by `neon deploy` / `neon checkout`; pooled URL for the app, unpooled for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 32+ chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Phase 4
GEMINI_API_KEY=
