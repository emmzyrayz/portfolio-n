# Copy to .env.local and fill in. Never commit .env.local.

# Owner (only this email can log in)
OWNER_EMAIL=

# SMTP (personal email; for Gmail use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# GitHub: GITHUB_TOKEN powers the dashboard repo import (needs access to private repos: classic `repo` scope, or a fine-grained token with Metadata: read on all repositories). Server-only, never NEXT_PUBLIC_.
GITHUB_USERNAME=
GITHUB_TOKEN=

# Neon (pulled by `neon deploy` / `neon checkout`; pooled URL for the app, unpooled for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 32+ chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# CV builder (server-only, never NEXT_PUBLIC_)
GEMINI_API_KEY=
# Optional: pin the Gemini model (default: gemini-flash-latest, which tracks the newest Flash)
GEMINI_MODEL=

# API hub key hashing (32+ chars, server-only). Separate from SESSION_SECRET on purpose.
# Rotating it invalidates EVERY issued hub API key. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HUB_KEY_SECRET=

# Mail dry run (tests/staging only): 1 = skip the SMTP call and return a fake id. Ignored on Vercel production.
MAIL_DRY_RUN=
